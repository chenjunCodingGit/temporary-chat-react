{
  "name": "temporary-chat-react",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:lib": "tsc && vite build --config vite.config.ts --mode sit",
    "build:embed": "vite build --config vite.config.embed.ts",
    "build:package": "vite build --config vite.config.package.ts",
    "start:chat-app-server": "node chat-app-server.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "main": "./dist/package/index.umd.js",
  "module": "./dist/package/index.es.js",
  "types": "./dist/package/index.d.ts",
  "files": [
    "dist/package"
  ],
  "exports": {
    ".": {
      "import": "./dist/package/index.es.js",
      "require": "./dist/package/index.umd.js",
      "types": "./dist/package/index.d.ts"
    },
    "./style.css": "./dist/package/style.css"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.13.0",
    "@azure/msal-react": "^3.0.12",
    "@chatui/core": "^3.0.0",
    "@microsoft/omnichannel-chat-sdk": "^1.11.3-main.ad7ffbc",
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.9.0",
    "clsx": "^1.1.1",
    "core-js": "^3.31.0",
    "cors": "^2.8.5",
    "dompurify": "^3.2.5",
    "express": "^5.1.0",
    "history": "^5.3.0",
    "intersection-observer": "^0.12.2",
    "jwt-decode": "^4.0.0",
    "marked": "^15.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/node": "^22.15.23",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "less": "^4.3.0",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vite-plugin-dts": "^3.9.1"
  }
}
